# RenewBrick build/serve configuration.
# Copy to .env.production (or set in your static host's dashboard).
# The site is static: there are no secrets. Never use the NEXT_PUBLIC_ prefix.

# Canonical origin, no trailing slash. Must be https:// in production.
# Read at BUILD time (canonical URLs, sitemap, Open Graph) — rebuild after changing.
SITE_URL=https://www.example.com

# Search indexing. Leave unset/false for previews and staging.
# Set to true ONLY for the production build.
SITE_INDEXING=false

# Local static server (start.sh / npm start)
PORT=3000
# 127.0.0.1 behind nginx; 0.0.0.0 to listen on all interfaces.
HOST=127.0.0.1
