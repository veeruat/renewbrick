# RenewBrick environment configuration.
# Copy to .env.production (server) or .env.local (development) and fill in.
# NEVER commit real values. Nothing here may use the NEXT_PUBLIC_ prefix.

# --- Site ---------------------------------------------------------------
# Canonical origin, no trailing slash. Must be https:// in production.
# Read at BUILD time (canonical URLs, sitemap, Open Graph) — rebuild after changing.
SITE_URL=https://www.example.com
# Search indexing. Leave unset/false for previews and staging.
# Set to true ONLY for the production build.
SITE_INDEXING=false

# --- Server (start.sh) --------------------------------------------------
PORT=3000
# Interface to bind. Keep 127.0.0.1 behind nginx; 0.0.0.0 to expose directly.
HOST=127.0.0.1

# --- Lead storage (PostgreSQL 14+) --------------------------------------
DATABASE_URL=postgres://renewbrick_app:CHANGE_ME@db.example.com:5432/renewbrick
# true (default) = TLS with certificate verification; no-verify = TLS without
# verification (some managed hosts); false = no TLS (local only).
DATABASE_SSL=true
DATABASE_POOL_MAX=5
# Secret used to hash IP addresses for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_HASH_SALT=

# --- Lead notification email (Resend) -----------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender on a domain verified in Resend.
LEAD_NOTIFY_FROM="RenewBrick Website <enquiries@example.com>"
# Comma-separated recipients.
LEAD_NOTIFY_TO=owner@example.com
