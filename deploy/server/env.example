# RenewBrick server settings - copy to .env on the server (cp env.example .env; chmod 600 .env).

# Enquiry form: where enquiries are emailed, and the sender (must be on the verified renewbrick.com
# SES identity). While SES is in its sandbox, CONTACT_RECIPIENT must be a verified address too.
CONTACT_RECIPIENT=renewbrick@gmail.com
CONTACT_SENDER="RenewBrick website <noreply@renewbrick.com>"

# Amazon SES SMTP (us-east-1). SMTP_USER/SMTP_PASSWORD come from the IAM user ses-smtp-renewbrick,
# which may only send as noreply@renewbrick.com. They are SMTP credentials, not AWS access keys.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Email Let's Encrypt writes to about the certificate.
CERT_EMAIL=renewbrick@gmail.com

# The address the domain must point to before `renewbrick.sh cert` asks for a certificate.
SERVER_IP=13.201.211.121
